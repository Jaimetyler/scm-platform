# Set on Vercel Production and locally before bootstrap (no trailing slash).
SCM_APP_URL=https://scm-platform-pnl.vercel.app
# Reuse existing Supabase project URL and service-role key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-EXISTING-SERVICE-ROLE-KEY
# For npm run dev, override SCM_APP_URL in .env.local with http://localhost:3000.
# SMTP host/user/password are configured in Supabase, not here.
